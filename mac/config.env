# MemGuard thresholds and behavior. Copy to ~/.memguard/config.env to override.
#
# Calibration note: swap *free* is not a usable signal on macOS. The kernel
# keeps the swap file near capacity and grows it on demand, so it reads ~0.7 GB
# on a healthy machine. The signals that actually move ahead of an out-of-memory
# event are the free-memory percentage, the kernel pressure level, how fast swap
# is growing, and whether the boot disk still has room for swap to grow into.

#
# kern.memorystatus_level ("free %") is not usable either. It read 33-62% at
# all 41 recorded incidents, including the one three minutes before an
# out-of-memory dialog. It counts compressible memory as free.
#
# The primary signal is LOAD: swap used plus compressor, as a percent of
# physical RAM. It is a level, not a rate, so it does not flap. Calibrated on
# a 36 GB machine: ~104% after recovery, 131-137% in the 30 minutes before the
# out-of-memory dialog on 2026-10-08.

# --- Tier thresholds ---------------------------------------------------------
WARN_LOAD_PCT=120              # (swap used + compressor) / RAM at or above this
CRIT_LOAD_PCT=130

WARN_FREE_PCT=10               # kept as a backstop; rarely fires on its own
CRIT_FREE_PCT=5

# Swap growth is spiky. It can only raise WARN, never CRITICAL.
WARN_SWAP_GROWTH_GB_PER_MIN=1.5

CRIT_DISK_FREE_GB=15           # swap cannot grow past the disk; this is the wall

# --- Hysteresis (samples, not seconds) --------------------------------------
ESCALATE_AFTER=2
DEESCALATE_AFTER=30             # ~5 minutes; a short all-clear hid real danger

# --- Daemon ------------------------------------------------------------------
POLL_SECONDS=10
RELIEF_COOLDOWN_SECONDS=300
# While WARN or CRITICAL holds, alert again after this many seconds.
REALERT_SECONDS=600
# CRITICAL opens a dialog that stays until dismissed, not a 5-second banner.
CRITICAL_DIALOG=1

# --- Relief ------------------------------------------------------------------
# purge drops only the file cache. Pressure here is anonymous memory
# (compressed and swapped app pages), which purge cannot touch, and the cache
# refills within minutes. Off by default; reclaiming idle tabs is the real fix.
ENABLE_PURGE=0
# Writes kern.memorypressure_manual_trigger. Leave at 0 until tested by hand.
ENABLE_PRESSURE_PULSE=0
PRESSURE_PULSE_SECONDS=3

# --- Reclaim candidate selection --------------------------------------------
CANDIDATE_IDLE_CPU_MAX=5.0     # percent CPU; above this the process is working
CANDIDATE_MIN_RSS_MB=100
RECLAIM_TARGET_GB=4            # "Reclaim safe tabs" stops after roughly this much
